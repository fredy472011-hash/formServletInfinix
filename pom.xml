<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Igual que webapp-formFC: un proyecto web (war) con Java 21 y Jakarta EE 11 -->
    <groupId>com.fredy.infinix</groupId>
    <artifactId>formServletInfinix</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>war</packaging>

    <properties>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <dependencies>
        <!-- Servlets, JSP y sesion. "provided": Tomcat ya la trae, no viaja dentro del war -->
        <dependency>
            <groupId>jakarta.platform</groupId>
            <artifactId>jakarta.jakartaee-api</artifactId>
            <version>11.0.0</version>
            <scope>provided</scope>
        </dependency>

        <!-- NUEVO: BCrypt, para guardar la contrasenha como "hash" y no como texto -->
        <dependency>
            <groupId>org.mindrot</groupId>
            <artifactId>jbcrypt</artifactId>
            <version>0.4</version>
        </dependency>

        <!-- NUEVO: OpenPDF, para generar los reportes en PDF (paquete com.lowagie) -->
        <dependency>
            <groupId>com.github.librepdf</groupId>
            <artifactId>openpdf</artifactId>
            <version>2.4.0</version>
        </dependency>

        <!-- NUEVO: ZXing (de Google), para dibujar el codigo QR del pago -->
        <dependency>
            <groupId>com.google.zxing</groupId>
            <artifactId>javase</artifactId>
            <version>3.5.4</version>
        </dependency>

        <!-- El driver de MySQL NO va aca: ya esta en la carpeta lib de tu Tomcat 11 -->
    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
            </plugin>

            <!--
              Para subir el war a Tomcat:  mvn package tomcat7:redeploy
              El usuario y la clave del "manager" de Tomcat salen de variables de entorno,
              porque este proyecto esta en GitHub y no se deben ver. Una sola vez, en PowerShell:
                  setx TOMCAT_USER "admin"
                  setx TOMCAT_PASSWORD "tu_clave"
            -->
            <plugin>
                <groupId>org.apache.tomcat.maven</groupId>
                <artifactId>tomcat7-maven-plugin</artifactId>
                <version>2.2</version>
                <configuration>
                    <url>http://localhost:8080/manager/text</url>
                    <username>${env.TOMCAT_USER}</username>
                    <password>${env.TOMCAT_PASSWORD}</password>
                </configuration>
            </plugin>

            <plugin>
                <artifactId>maven-war-plugin</artifactId>
                <version>3.4.0</version>
                <configuration>
                    <failOnMissingWebXml>false</failOnMissingWebXml>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
